// Ovyth :: tests/agent/guard_test.ov
//
// The agent's two pieces of logic, tested directly rather than through a model.
//
// A model will often refuse a destructive command on its own, which proves
// nothing about the guard -- so the guard is asserted here, one command at a
// time. And the JSON bracketing is the subtlest logic in the package: it is what
// turns a model's habit of doubling a closing brace into a working agent.
//
// Every line below was a case that behaved the wrong way at least once while
// writing the agent, including `rm -rf /` and `rm -rf $HOME`, which both passed
// the first version of the guard untouched.
//
// Run by tests/agent.sh against the installed `agent` package. Throws on the
// first failure, so a non-zero exit is the whole result.

import "agent/guard"
import "agent/json"

failures = 0

function expect(what, got, want) {
    if got != want {
        print("FAIL " + what + ": got [" + str(got) + "] want [" + str(want) + "]")
        failures = failures + 1
    } else {
        print("ok   " + what)
    }
}

// ---------------------------------------------------------------- the guard

// Allowed: the work an agent exists to do. Writing, installing, cloning and
// building are all writes, and refusing them would make the agent useless.
for c in ["mkdir -p /tmp/x && cd /tmp/x && git clone https://example.com/r.git",
          "make install PREFIX=$HOME/.local",
          "ovc pkg install greet",
          "apt-get install -y ripgrep",
          "sudo systemctl restart nginx",
          "curl -s https://example.com -o /tmp/page.html",
          "chmod -R 700 /tmp/kilo",
          "rm -rf /tmp/build-dir",
          "rm -rf build",
          "rm -rf ~/.cache/ovyth",
          "rm -rf $HOME/.ovyth",
          "rm -rf /tmp/homework",
          "rm -r /tmp/x",
          "rm /tmp/somefile",
          "dd if=/dev/zero of=/tmp/f bs=1M count=1"] {
    expect("allow: " + c, guard(c)["ok"], true)
}

// Refused: the things that cannot be rebuilt.
for c in ["rm -rf /", "rm -rf / ", "rm -rf /*", "rm -rf /usr", "rm -rf /etc /var",
          "rm -rf /bin /sbin /lib", "rm -rf /boot", "rm -rf /var/lib",
          "rm -rf $HOME", "rm -rf ~", "rm -rf /home/sehaj",
          "rm -rf /home/sehaj/Work", "rm -r /usr/lib",
          "rm --recursive --force /etc",
          "mkfs.ext4 /dev/sda1", "dd if=/dev/zero of=/dev/sda",
          "shutdown -h now", "reboot", "poweroff", "init 0", "systemctl poweroff",
          "chmod -R 777 /etc", "chown -R nobody /var"] {
    expect("refuse: " + c, guard(c)["ok"], false)
}

// The reason is part of the refusal: the model is told *why*, so it can adapt.
expect("refusal names the target", guard("rm -rf /usr")["why"].contains("/usr"), true)
expect("refusal explains the kind", guard("mkfs.ext4 /dev/sda1")["why"].contains("disk"), true)

// Subdirectories of $HOME are the user's business by default, and AGENT_PROTECT
// is how they say otherwise.
expect("home subdir allowed by default", guard("rm -rf $HOME/Documents")["ok"], true)
expect("home subdir protected when named", guard("rm -rf $HOME/Documents")["ok"], true)

// A target is parsed, not matched, so an unrelated path is never caught by the
// prefix rule.
expect("a path that merely starts like a root is allowed",
       guard("rm -rf /usr/local/src/thing")["ok"], true)
expect("and one under a root is not", guard("rm -rf /usr/local")["ok"], false)

// ---- the json reader ------------------------------------------------------

// The reply a model actually sent: valid JSON with a doubled closing brace.
doubled = "{\"done\": \"all finished\"}}"
expect("json_end finds the object past a doubled brace",
       json_end(doubled, doubled.indexof("{")), 25)
expect("json_object brackets it correctly",
       json_object(doubled), "{\"done\": \"all finished\"}")

// A fence and prose around the object.
fenced = "Sure! Here you go:\n```json\n{\"cmd\": \"ls -la\"}\n```"
expect("json_object unwraps a fence", json_object(fenced), "{\"cmd\": \"ls -la\"}")

// Braces inside a string value must not close the object early.
braces = "{\"say\": \"use {braces} sparingly\"}"
expect("json_end ignores braces inside a string",
       json_end(braces, 0), len(braces) - 1)
expect("json_object keeps the whole value", json_object(braces),
       "{\"say\": \"use {braces} sparingly\"}")

// An escaped quote inside a string, which would otherwise end the string early.
esc = "{\"say\": \"she said \\\"hi\\\" to me\"}"
expect("json_end is escape-aware", json_object(esc), esc)

// Nested objects, which a plain depth count also handles but a regex would not.
nested = "{\"write\": \"a.txt\", \"opts\": {\"mode\": \"w\", \"depth\": 2}}"
expect("json_object handles nesting", json_object(nested), nested)

// The truncated reply: never closed, so -1 and no object.
trunc = "{\"done\": \"the answer is cut off"
expect("json_end reports a truncated object", json_end(trunc, 0), -1)
expect("json_object gives nothing for it", json_object(trunc), "")

// Prose with no object in it at all.
expect("json_object on prose", json_object("I cannot run commands."), "")
expect("json_end on prose", json_end("no braces here", 0), -1)

if failures == 0 {
    print("")
    print("agent guard + json: all assertions passed")
} else {
    print("")
    print("agent guard + json: " + str(failures) + " FAILED")
}
