// Ovyth :: examples/chatbot/chatbot.ov
//
// A chatbot — the *application*, built on the `ai` module.
//
// Everything that talks to a model lives in the ai module: `ai_conversation`
// starts history, `ai_ask`/`ai_told` extend it, `ai_trim` bounds it, and
// `ai_chat` returns the reply. This file is the loop, the prompt, and the
// demo mode — the parts that are specific to being a chatbot, and to nothing
// else. A tool agent or a batch script would reuse the module and differ
// from this file only here.
//
// Environment variables:
//   AI_API_KEY   - bearer token for the endpoint (required)
//   AI_API_URL   - chat endpoint (default: https://api.example.com/v1/chat)
//   AI_MODEL     - model name   (default: my-model)
//
// Run:
//   AI_API_KEY=sk-... ovc run examples/chatbot/chatbot.ov
//
// With no key it runs in demo mode: same code path, offline replies, so the
// loop and the history handling are still worth reading and testing.

import "ai"

api_key = env_or("AI_API_KEY", "")
api_url = env_or("AI_API_URL", "https://api.example.com/v1/chat")
model   = env_or("AI_MODEL", "gpt-4o-mini")

demo = api_key == ""
if demo {
    print("DEMO MODE: no AI_API_KEY, so replies are offline and fake")
}

system = "You are a helpful automation assistant. Be brief."
history = ai_conversation(system)
turns = 0

print("=== ovyth chatbot ===")
print("type 'exit' to quit")
print("")

while true {
    user_input = input("> ")

    if user_input == "" or user_input == "exit" or user_input == "quit" {
        break
    }

    turns = turns + 1
    ai_ask(history, user_input)

    reply = ""
    if demo {
        r = ai_offline_reply(user_input)
        reply = r["text"]
    } else {
        r = ai_request(api_url, api_key, model, history, 30.0)
        if r["ok"] {
            reply = r["text"]
        } else {
            print("error: " + r["error"] + " (status " + str(r["status"]) + ")")
        }
    }

    print("Assistant: " + reply)
    ai_told(history, reply)

    // Bound the history: keep the system message plus the newest turns.
    history = ai_trim(history, 20)
}

print("")
print("Goodbye! " + str(turns) + " turn(s), " + str(len(history)) + " message(s) in history")
