// Ovyth :: examples/rag/rag_pipeline.ov
//
// The RAG pipeline, now as an *application* on top of the `rag` module
// instead of a reimplementation of it.
//
// Stages:
//   documents -> chunk -> embed -> store -> query -> retrieve -> generate
//
// Everything between the first two arrows is `ovc pkg install rag`; this file
// is the corpus, the query, and the reporting, which is what an example
// should be. The chatbot and a tool agent differ from this one only in what
// they put in `docs` and what they do with the answer.
//
// Run:
//   ovc run examples/rag/rag_pipeline.ov
//
// Or with a live endpoint (the rag module never calls one itself):
//   AI_API_KEY=... AI_API_URL=... AI_MODEL=... ovc run examples/rag/rag_pipeline.ov

import "rag"

print("=== ovyth rag pipeline ===")

// ----------------------------------------------------------------- corpus

documents = [
    "Ovyth is a compiled language for AI automation and agent workloads. It compiles .ov files to native executables with zero VM overhead.",
    "RAG stands for Retrieval Augmented Generation. It retrieves relevant context from a knowledge base before sending a prompt to an LLM.",
    "Vector search finds the most semantically similar chunks to a query by computing cosine similarity between embedding vectors.",
    "An arena allocator frees all objects in O(1) by releasing a whole memory block, avoiding per-object malloc and free overhead.",
    "JSON parsing is on the hot path for every LLM API call. SIMD scanning can process 16 bytes per instruction instead of one.",
    "Connection pooling reuses TCP and TLS sessions across requests, eliminating handshake overhead per API call.",
    "Pipeline fusion combines multiple data transformations into a single pass, reducing allocations and improving cache locality.",
]

// ----------------------------------------------------------------- build

t0 = time.clock()
store = rag_build(documents, 8, 2)
print("stage=build docs=" + str(len(documents)) + " chunks=" + str(len(store)) +
      " ms=" + str(round((time.clock() - t0) * 1000.0)))

// ----------------------------------------------------------------- retrieve

queries = [
    "how does cosine similarity work",
    "why is json parsing slow",
    "what makes compiled binaries fast",
]

q = 0
while q < len(queries) {
    query = queries[q]
    t0 = time.clock()

    // Lexical ranking: no model, no embeddings, works offline.
    hits = rag_topk(store, query, 2)

    elapsed = (time.clock() - t0) * 1000.0
    print("")
    print("query: " + query)
    print("  retrieved=" + str(len(hits)) + " ms=" + str(round(elapsed)))
    i = 0
    while i < len(hits) {
        print("  [" + str(i + 1) + "] score=" + str(hits[i]["score"]) + " " + hits[i]["text"])
        i = i + 1
    }

    // The prompt is what a caller would send to ai_say().
    prompt = rag_prompt(query, hits, 220)
    print("  prompt_bytes=" + str(len(prompt)))

    q = q + 1
}

// ----------------------------------------------------------------- persist

// The store is plain data, so it survives as JSON and reloads as a store.
if rag_save(store, "/tmp/ovyth-rag-store.json") {
    reloaded = rag_load("/tmp/ovyth-rag-store.json")
    print("")
    print("stage=persist chunks=" + str(len(reloaded)) + " (saved and reloaded)")
} else {
    print("")
    print("stage=persist skipped (cannot write /tmp)")
}

print("")
print("=== done ===")
