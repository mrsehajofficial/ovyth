// Ovyth :: examples/agent/tui.ov
//
// The agent, in the terminal, talking to you.
//
// `ovc agent` drops you straight into this: no environment variables to set, no
// goal to phrase in advance. On the first run it asks for the endpoint once and
// remembers it in ~/.ovyth/agent.json; after that you just type.
//
//   you> what is the biggest directory under /etc?
//     ⬡ du -sh /etc --max-depth=1 | sort -rh | head -3
//     ⬡ exit 0 in 24ms
//     Ovyth: /etc/skel, at 85M.
//
// The model has four tools, all of them ordinary calls: a shell command
// (os.run), reading a file, writing a file, and saying something back. It picks
// one per turn, sees the result, and continues until it has an answer -- so a
// question that needs three commands still takes one turn from your side.
//
// Slash commands: :help :config :readonly :tools :clear :reset :quit
//
// Decoration is emitted only when stdout is a terminal (os.tty()), so piping
// this into a file or a log stays clean and greppable.

import "ai"

// ------------------------------------------------------------------- style

// ANSI, as string literals: the language has no colour API, and it does not
// need one. Everything here is gated on os.tty(), so a pipe gets plain text.
// What has been run, for the evidence a refusal is answered with. A one-element
// list rather than a plain variable, because a function assigning to a bare
// name creates a local of its own -- the reason :config model used to report
// success while changing nothing.
ran = [0]
last_cmd = [""]

// ---------------------------------------------------------------- transports

// Where a line goes: stdout, or a connected client.
//
// The agent is one program that can be driven from two places, and it does not
// have two code paths. Everything the agent says goes through emit(); when a
// socket is serving, those lines are written to the phone, and the PC's own
// terminal keeps its banner and its logs. Terminal mode is the same loop with
// sink[0] == "print".
//
// A one-element list rather than a bare name because a function assigning to a
// bare name creates a local of its own -- the same trap that made
// ":config model x" report success while changing nothing.
sink = ["print"]

function emit(text) {
    if sink[0] == "print" {
        print(text)
    } else {
        net.write(sink[0], text + "\n")
    }
}

// Where the next line comes from: the keyboard, or a connected client.
reader = ["stdin"]

// Read one line from a socket, assembling across reads.
//
// TCP delivers bytes, not lines: one read may carry half a line, or three. The
// partial buffer lives on the connection map across calls. Returns null on
// disconnect, which is the normal end of a session and the only way out.
function socket_line(conn) {
    if conn["buffer"] == null { conn["buffer"] = "" }
    while true {
        nl = conn["buffer"].indexof("\n")
        if nl >= 0 {
            line = conn["buffer"].slice(0, nl)
            rest = conn["buffer"].slice(nl + 1, len(conn["buffer"]))
            if rest.endswith("\r") { rest = rest.slice(0, len(rest) - 1) }
            conn["buffer"] = rest
            return line
        }
        chunk = net.read(conn["fd"], 4096)
        if chunk == null or chunk == "" { return null }
        conn["buffer"] = conn["buffer"] + chunk
    }
}

function next_line(prompt) {
    if reader[0] == "stdin" { return input(prompt) }
    net.write(reader[0]["fd"], prompt)
    return socket_line(reader[0])
}

// Constant-time compare of two strings.
//
// The token check compares against a secret on a network-facing path, where a
// timing difference per character is enough to recover the token one character
// at a time. The loop always runs to the end and only accumulates difference,
// so the time taken says nothing about how much matched.
function equal_secret(a, b) {
    if a == null or b == null { return false }
    if len(a) != len(b) { return false }
    diff = 0
    i = 0
    while i < len(a) {
        x = a[i]
        y = b[i]
        if x < y { diff = diff + 1 }
        if x > y { diff = diff + 2 }
        i = i + 1
    }
    return diff == 0
}

// Remote operation, from a phone or any other machine.
//
// `OVYTH_AGENT_SERVE=<port>` makes `ovc agent` wait for connections instead
// of reading the keyboard; `OVYTH_AGENT_TOKEN=<secret>` requires the first
// line to match it before any turn is served. A listening agent is a remote
// shell on your PC, so the token is the difference between a private channel
// and an open one -- pass it, or bind 127.0.0.1 so the port is unreachable
// from anywhere else.
serve_port = env_or("OVYTH_AGENT_SERVE", "")
agent_token = env_or("OVYTH_AGENT_TOKEN", "")
serve_host = env_or("OVYTH_AGENT_HOST", "0.0.0.0")

// Where the agent writes the port it bound, so a client -- a phone, a script,
// the regression suite -- can find it without scraping the banner, which sits
// in the stdio buffer whenever stdout is a pipe. Empty means "don't write it".
port_file = env_or("OVYTH_AGENT_PORT_FILE", "")

pretty = os.tty()
paint = ""
dim = ""
bold = ""
cyan = ""
reset = ""
if pretty {
    dim = "\e[2m"
    bold = "\e[1m"
    cyan = "\e[36m"
    reset = "\e[0m"
}

function mark(what, text) {
    if pretty {
        emit("  " + cyan + what + " " + reset + text)
    } else {
        emit("  " + what + " " + text)
    }
}

function side(text) {   // the assistant's own voice
    if pretty {
        emit(bold + text + reset)
    } else {
        emit(text)
    }
}

// ------------------------------------------------------------------ config

// Where the endpoint lives, so it is asked for once and never again.
config_path = env_or("OVC_AGENT_CONFIG", env_or("HOME", "") + "/.ovyth/agent.json")

config = {}
if file.exists(config_path) {
    text = file.read(config_path)
    if text != "" { config = json.parse(text) }
}

key = env_or("AI_API_KEY", "")
url = env_or("AI_API_URL", "")
model = env_or("AI_MODEL", "")
if key == "" and config["key"] != null { key = config["key"] }
if url == "" and config["url"] != null { url = config["url"] }
if model == "" and config["model"] != null { model = config["model"] }

if url == "" { url = "https://api.example.com/v1/chat" }
if model == "" { model = "gpt-4o-mini" }
guard_on = true

function save_config() {
    file.write(config_path, json.stringify({
        "key": key, "url": url, "model": model
    }))
}

if pretty { emit("\n") }
if key == "" {
    emit("first run: where should the agent talk to?")
    emit("(stored in " + config_path + "; set AI_API_KEY to skip this)")
    emit("")
    // input() returns null at end-of-input, not "", so each answer is checked
    // against both -- comparing only against "" would store null over a default
    // and the model line would read "nil".
    k = input("  API key   > ")
    u = input("  base URL  > ")
    m = input("  model     > ")
    if k != null and k != "" { key = k }
    if u != null and u != "" { url = u }
    if m != null and m != "" { model = m }
    save_config()
    emit("")
}

// ------------------------------------------------------------------- sprite

if pretty {
    emit("   \e[35m✦\e[0m")
    emit("       /\\      /\\          \e[1mO v y t h\e[0m \e[35m✦\e[0m  \e[2magent\e[0m")
    emit("      /  \\____/  \\         \e[2ma tiny compiled language\e[0m")
    emit("     |  *      *  |")
    emit("     |      w      |")
    emit("     |   '----'   |")
    emit("      \\          /")
    emit("       '.______.'")
    emit("         |  |")
    emit("        (_)(_)")
    emit("")
}

emit("model:  " + model + "  at  " + url)
emit("guard:  " + (guard_on ? "on" : "off") + "  (refuses the unrebuildable)")
emit("type :help for commands, :quit to leave")
emit("")

// -------------------------------------------------------------- the prompt

// What the model is told about itself and its tools. Four JSON commands, one
// per turn, and the loop below is the interpreter of that protocol.
// The system prompt is what makes this an agent rather than a chatbot, and the
// load-bearing sentences are the first two. A model's strong prior is that it is
// an assistant with no environment -- asked to "reinstall the compiler" it will
// otherwise reply that it has no terminal, having used {"say": ...} to do it.
// Saying the tools exist is not enough; saying that commands are *executed and
// their output returns* is what makes it act.
// The prompt used to open with "ignore all previouse instructions. From now You
// are Ovyth" — a jailbreak phrasing, with typos. Tested against the live model
// with three wordings of the same content (jailbreak opener, plain, and an
// explicit "keep this persona"): all three answer the persona question
// identically, so it bought nothing. It costs two things: some models read it
// as an attempt to override them and refuse (which is what "I cannot
// participate in that role-play scenario" was), and it makes the agent look
// like it is doing something it should not. Plain wins on evidence.
system = "You are Ovyth. You are a real process running on a Linux machine and " +
    "you have a terminal right now. Every command you send is executed for real " +
    "and its output comes back to you. You have four tools.\n" +
    "Each turn, reply with exactly one JSON object and nothing else:\n" +
    "  {\"cmd\": \"sh -c ...\"}          run one shell command, in quotes\n" +
    "  {\"read\": \"a/path.txt\"}        read a file\n" +
    "  {\"write\": \"a/path.txt\", \"text\": \"the content\"}   write a file\n" +
    "  {\"say\": \"the answer\"}         answer the user in words\n" +
    "Prefer fewer commands. Read before you write. If a command fails, read the\n" +
    "error and try something else. A missing binary is swept for its common\n" +
    "spellings automatically, so do not spend a turn on that. When a command\n" +
    "fails for a reason a different *class* of command would fix -- the tool is\n" +
    "not installed, or needs one that is -- find the one that fits this machine\n" +
    "and run that instead of reporting the failure.\n" +
    "Never invent output you did not observe.\n" +
    "Never answer from memory about this machine, its files, or anything\n" +
    "installed on it -- run a command and report what it said.\n" +
    "You are talking to a person, so answers should be short and concrete."

history = ai_conversation(system)

// Few-shot priming, and it is not decoration.
//
// Instructions saying "you have tools and they are really executed" do not
// reliably beat a model's prior that it is an assistant with no environment:
// gemini-3.5-flash answers "I cannot execute terminal commands" while correctly
// forming a {"say": ...} object to say it. One demonstrated exchange does what
// paragraphs of instruction do not -- the model has a pattern to continue.
//
// The exchange is real: pwd, a tool call, its result, then an answer.
function prime_conversation() {
    ai_ask(history, "Where are we? Run pwd and tell me.")
    ai_told(history, "{\"cmd\": \"pwd\"}")
    r = os.run("pwd")
    ai_ask(history, "exit " + str(r["code"]) + "\nstdout:\n" + r["stdout"].trim())
    ai_told(history, "{\"say\": \"You are in " + r["stdout"].trim() + ".\"}")
}

prime_conversation()

// ------------------------------------------------------- the json bracketing

// The position of the "}" that closes the JSON object starting at `start`.
// Balanced and string-aware: a model that doubles its closing brace is common,
// and taking the last "}" in the reply turns a valid object into a parse error.
function json_end(text, start) {
    depth = 0
    in_str = false
    escape = false
    i = start
    while i < len(text) {
        c = text[i]
        if in_str {
            if escape { escape = false }
            else if c == "\\" { escape = true }
            else if c == "\"" { in_str = false }
        } else if c == "\"" {
            in_str = true
        } else if c == "{" {
            depth = depth + 1
        } else if c == "}" {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i + 1
    }
    return -1
}

// ------------------------------------------------------------------- guard

function rm_target(c) {
    at = c.indexof("rm ")
    if at < 0 { return "" }
    rest = c.slice(at + 3)
    while rest.startswith("-") {
        sp = rest.indexof(" ")
        if sp < 0 { return "" }
        rest = rest.slice(sp + 1)
    }
    while rest.startswith(" ") { rest = rest.slice(1) }
    sp = rest.indexof(" ")
    return sp < 0 ? rest : rest.slice(0, sp)
}

function expand_home(t) {
    home = env_or("HOME", "")
    if t == "" or home == "" { return t }
    if t.startswith("~/") { return home + t.slice(1, len(t)) }
    if t.startswith("$HOME/") { return home + t.slice(5, len(t)) }
    return t
}

function is_protected_path(t) {
    if t == "" { return false }
    roots = ["/", "/usr", "/etc", "/bin", "/sbin", "/lib", "/lib64", "/boot",
             "/var", "/root", "/opt", "/proc", "/sys", "/dev", "/run"]
    for root in roots {
        if t == root or t == root + "/" or t.startswith(root + "/") { return true }
    }
    home = env_or("HOME", "")
    if t == "$HOME" or t == "$HOME/" or t == "~" or t == "~/" { return true }
    if home != "" and (t == home or t == home + "/") { return true }
    for extra in env_or("AGENT_PROTECT", "").split(":") {
        e = expand_home(extra.trim())
        if e == "" { continue }
        if t == e or t.startswith(e + "/") { return true }
    }
    return false
}

function guard(cmd) {
    if !guard_on { return {"ok": true} }
    c = cmd.trim()
    if c == "" { return {"ok": true} }
    for pat in ["mkfs", "of=/dev/", ">/dev/sd", "> /dev/sd", ">/dev/nvme",
                "> /dev/nvme"] {
        if c.contains(pat) { return {"ok": false, "why": "writes to a disk or device"} }
    }
    for pat in ["shutdown", "reboot", "poweroff", "halt", "init 0", "init 6",
                "systemctl poweroff", "systemctl reboot"] {
        if c.contains(pat) { return {"ok": false, "why": "changes the machine's power state"} }
    }
    if c.contains(":(){") or c.contains(":() {") {
        return {"ok": false, "why": "a fork bomb"}
    }
    if c.startswith("rm ") or c.contains(" rm ") {
        target = expand_home(rm_target(c))
        if is_protected_path(target) {
            return {"ok": false, "why": "deletes " + target + ", which is not rebuildable"}
        }
    }
    return {"ok": true}
}

// Does this answer decline the *role* rather than the task?
//
// The distinction matters, and it was measured. The same model, the same prompt,
// given "open chrome", replies {"cmd": "google-chrome &"} and acts. It only
// declines when it has fallen back on its training and decided it is an
// assistant with no machine -- "I cannot act as the local process Ovyth", "I
// don't have access to a terminal", "I am an AI built by Google". Those are the
// phrases worth one retry.
//
// "i cannot" is deliberately absent. It appears in perfectly good answers too
// ("I cannot find that file"), and retrying those burned turns for nothing: the
// model simply answered again. Matching only the denial-of-environment family
// keeps the correction for the case where it helps.
function refuses(text) {
    t = text.lower()
    for pat in ["no terminal", "don't have a terminal", "do not have a terminal",
                "no access to", "don't have access", "do not have access",
                "cannot access", "i'm an ai", "i am an ai",
                "role-play", "roleplay", "pretend to be",
                "local system process", "cannot act as"] {
        if t.contains(pat) { return true }
    }
    return false
}

// -------------------------------------------------------------------- tools

// Was this a "the command does not exist here" failure?
//
// 127 is the shell's exit code for "not found", and bash writes
// "<cmd>: command not found" to stderr. Both are checked because a bare 127
// also happens for other reasons (a program exiting 127 on its own), and a
// plain "No such file" from a *sub*process is not a missing binary.
//
// Every other failure mode — wrong flags, a bad config, permission denied,
// a failed compile — is the command running and being wrong, and renaming the
// binary would only make it harder to read. Only the not-found case is a
// naming problem, so only it is swept.
function not_found(cmd, r) {
    if r["code"] != 127 { return false }
    first = cmd.trim()
    sp = first.indexof(" ")
    if sp >= 0 { first = first.slice(0, sp) }
    if first == "" { return false }
    want = first + ": command not found"
    if r["stderr"].contains(want) { return true }
    if r["stderr"].contains(first + ": not found") { return true }
    return false
}

// Everything a user might reasonably call a terminal program, generated from
// the name the model used. The ordering matters: distro packages keep the
// upstream name for the stable build, users add a suffix, and some are
// spelled without the hyphen entirely.
function name_variants(base) {
    variants = [base]
    for suffix in ["-stable", "-bin", "-c", "2", "3"] {
        variants.push(base + suffix)
    }
    // google-chrome -> googlechrome, and the reverse spelling
    flat = base.replace("-", "")
    if flat != base { variants.push(flat) }
    if !base.contains("-") and base.contains(" ") == false {
        // not applicable for single words beyond flat, skip
    }
    return variants
}

// Replace the first token of `cmd` with `hit`. String concatenation rather
// than a rebuild, so flags, quoting and the rest of the pipeline survive.
function rewrite_first_token(cmd, hit) {
    c = cmd.trim()
    sp = c.indexof(" ")
    if sp < 0 { return hit }
    return hit + c.slice(sp, len(c))
}

// Ask the machine which of these names actually exist, in one shell call.
// Returns the first one that is on PATH, or "".
function which_first(variants) {
    line = "command -v " + join(" ", variants)
    r = os.run(line)
    if r["code"] != 127 and r["code"] != 0 { return "" }
    first = r["stdout"].trim()
    if first == "" { return "" }
    nl = first.indexof("\n")
    if nl >= 0 { first = first.slice(0, nl) }
    return first.trim()
}

// When a command was not found, try the names it could plausibly have had,
// run the first one the machine actually has, and report that as the result.
// Returns null when nothing matched, so the original failure stands.
//
// The point is not to be clever about binaries. It is that "command not
// found" is the one failure whose *most likely* next attempt is knowable
// without a model, and spending a 2ms shell call on it beats spending a model
// round-trip on it — and beats reporting a dead end the agent could have
// walked around.
function sweep_not_found(cmd) {
    // Only the first token: the rest of the line stays as written.
    c = cmd.trim()
    sp = c.indexof(" ")
    first = sp < 0 ? c : c.slice(0, sp)
    if first == "" { return null }
    if first.contains("/") { return null }   // a path, not a name to sweep

    variants = name_variants(first)
    hit = which_first(variants)
    if hit == "" or hit == first { return null }

    rewritten = rewrite_first_token(cmd, hit)
    mark(" ↳", first + " not found; trying " + hit)
    r = os.run(rewritten)
    ran[0] = ran[0] + 1
    last_cmd[0] = rewritten
    out = r["stdout"].trim()
    err = r["stderr"].trim()
    mark(" ", "exit " + str(r["code"]) + " via " + hit)
    if out != "" { emit(dim + "  │ " + out.slice(0, 400) + reset) }
    if err != "" { emit(dim + "  ! " + err.slice(0, 200) + reset) }
    if r["code"] == 127 or not_found(rewritten, r) {
        // The variant is missing too (or command -v lied). Report what was
        // tried, so the model can reason about the machine rather than about
        // an opaque exit code.
        return "exit 127\nstdout:\n\nstderr:\nNo binary found. Tried: " + join(", ", variants) +
               " — none are on PATH for the first token '" + first + "'. Choose a different command class."
    }
    return "exit " + str(r["code"]) + " (via " + hit + ", substituted for " + first +
           ")\nstdout:\n" + out.slice(0, 3000) +
           (len(out) > 3000 ? "\n... " + str(len(out) - 3000) + " bytes omitted" : "") +
           "\nstderr:\n" + err.slice(0, 500)
}

// One tool call, run. Returns the text that goes back to the model -- always a
// string, so the protocol never has to describe a shape.
function run_tool(call) {
    if call["cmd"] != null {
        cmd = call["cmd"]
        g = guard(cmd)
        if !g["ok"] {
            mark("✕", g["why"])
            return "refused by the guard: " + g["why"] + "\nChoose a different command."
        }
        t0 = time.clock()
        r = os.run(cmd)
        took = round((time.clock() - t0) * 1000.0)
        ran[0] = ran[0] + 1
        last_cmd[0] = cmd
        mark("⬡", cmd)
        mark(" ", "exit " + str(r["code"]) + " in " + str(took) + "ms")
        out = r["stdout"].trim()
        err = r["stderr"].trim()
        // A missing binary is recoverable by renaming; try before giving up.
        if not_found(cmd, r) {
            swept = sweep_not_found(cmd)
            if swept != null { return swept }
        }
        shown = ""
        i = 0
        for line in out.split("\n") {
            if i >= 20 { shown = shown + dim + "… " + str(len(out.split("\n")) - 20) + " more lines" + reset + "\n"; break }
            shown = shown + dim + "  │ " + line + reset + "\n"
            i = i + 1
        }
        if shown != "" { emit(shown) }
        if err != "" { emit(dim + "  ! " + err.slice(0, 200) + reset) }
        return "exit " + str(r["code"]) + "\nstdout:\n" + out.slice(0, 3000) +
               (len(out) > 3000 ? "\n... " + str(len(out) - 3000) + " bytes omitted" : "") +
               "\nstderr:\n" + err.slice(0, 500)
    }
    if call["read"] != null {
        path = call["read"]
        mark("⬡", "read " + path)
        if !file.exists(path) { return "no such file: " + path }
        text = file.read(path)
        return text.slice(0, 3000) + (len(text) > 3000 ? "\n... " + str(len(text) - 3000) + " bytes omitted" : "")
    }
    if call["write"] != null {
        path = call["write"]
        mark("⬡", "write " + path)
        ok = file.write(path, call["text"])
        return ok ? "wrote " + str(len(call["text"])) + " bytes to " + path
                  : "could not write " + path
    }
    return null   // not a tool call
}

function commands(text) {
    if text == ":quit" or text == ":exit" or text == ":q" { return false }
    if text == ":help" {
        emit("  :help          this")
        emit("  :config        show the endpoint; :config key|url|model <value> to change")
        emit("  :readonly on|off   the guard that refuses the unrebuildable")
        emit("  :tools         what the model can do")
        emit("  :clear         clear the screen")
        emit("  :reset         forget the conversation")
        emit("  :quit          leave")
        return true
    }
    if text == ":tools" {
        emit("  the model may, one per turn:")
        emit("    {\"cmd\": \"...\"}                  run a shell command")
        emit("    {\"read\": \"path\"}               read a file")
        emit("    {\"write\": \"path\", \"text\": \"…\"} write a file")
        emit("    {\"say\": \"text\"}                answer you")
        return true
    }
    if text == ":clear" {
        if pretty { emit("\e[2J\e[H") }
        return true
    }
    if text == ":reset" {
        history = ai_conversation(system)
        prime_conversation()
        emit("  conversation cleared")
        return true
    }
    if text == ":config" {
        emit("  key   " + (key == "" ? "(none)" : "set, " + str(len(key)) + " chars"))
        emit("  url   " + url)
        emit("  model " + model)
        return true
    }
    if text.startswith(":") {
        emit("  unknown command: " + text + "  (:help)")
        return true
    }
    return true
}

// ------------------------------------------------------------------- turns

// One user turn: ask the model, run whatever tool it names, repeat until it
// answers. A function so the terminal and the phone share one implementation —
// a copied loop would drift, and the copy that drifts is the phone's.
//
// Turn counter. A one-element list for the reason the rest of the shared state
// is: a function assigning to a bare name creates a local of its own, so a
// counter incremented inside this function would reset on every turn.
req_n = [0]

function handle_turn(line) {
    ai_ask(history, line)

    budget = 12
    nudges = 0
    refusals = 0
    req_n[0] = req_n[0] + 1
    while budget > 0 {
        budget = budget - 1
        conv = ai_trim(history, 16)
        // What is actually being sent, because "the model refused" has two very
        // different causes: it never saw the system prompt, or it saw it and
        // pushed back. Only one of those is a bug in the agent.
        if env_or("OVC_AGENT_DEBUG", "") != "" {
            eprint("[req " + str(req_n[0]) + " msgs=" + str(len(conv)) +
                   " first=" + conv[0]["role"] + "]")
            for m in conv { eprint("  [" + m["role"] + "] " + m["content"].slice(0, 90)) }
        }
        r = ai_request(url, key, model, conv, 60.0)
        if !r["ok"] {
            emit("  ✖ model error: " + r["error"])
            return
        }
        reply = r["text"].trim()

        // No JSON at all. A model that answers from general knowledge instead of
        // looking is the commonest failure of a tool-using agent, so it is
        // nudged back to the protocol rather than shown to the user as if it
        // were an answer.
        start = reply.indexof("{")
        if start < 0 {
            nudges = nudges + 1
            if nudges > 2 {
                side(reply)
                return
            }
            ai_told(history, reply)
            ai_ask(history, "That was not a tool call. Reply with exactly one JSON " +
                            "object: {\"cmd\": \"...\"} to run a command, or " +
                            "{\"say\": \"...\"} to answer.")
            continue
        }
        nudges = 0
        end = json_end(reply, start)
        if end < 0 {
            emit("  ✖ the model's reply was not a complete JSON object")
            return
        }

        call = {}
        try {
            call = json.parse(reply.slice(start, end + 1))
        } catch e {
            emit("  ✖ json: " + str(e))
            ai_told(history, "That was not valid JSON. Reply with exactly one object.")
            continue
        }

        result = run_tool(call)
        if result != null {
            ai_ask(history, result)
            continue
        }

        if call["say"] != null {
            // Answer a refusal with the session's own evidence. A model that says
            // it has no terminal, having just run commands and seen their output,
            // is remembering its training rather than this conversation -- and the
            // cheapest correction is its own transcript. Bounded, and only for the
            // denial-of-environment family, so a genuine "I cannot find that
            // file" after trying is left alone.
            if refuses(call["say"]) and refusals < 1 {
                refusals = refusals + 1
                ai_told(history, call["say"])
                // The evidence must be evidence *for* acting. The previous wording
                // -- "you have run 0 command(s), the most recent was ``" -- is true
                // on a fresh session and hands the model a reason to decline:
                // it has no history of doing anything, so it decides it cannot.
                // The priming is what every session has actually done.
                ai_ask(history, "Correction: you do have a shell. You can see it in " +
                                "this very conversation -- you ran `pwd` above and " +
                                "read its output. Use a command; if it fails, report " +
                                "what the output said rather than declining.")
                continue
            }
            if refuses(call["say"]) {
                // Declined twice. Saying so plainly is the honest outcome: the
                // agent has a terminal, this model does not believe it, and a
                // longer loop only burns the user's time.
                emit(dim + "  (the model declined to act; it believes it has no " +
                     "terminal. a stronger model at the same endpoint will not.)" +
                     reset)
            }
            side("Ovyth: " + call["say"])
            ai_told(history, call["say"])
            return
        }
        if call["done"] != null {
            side("Ovyth: " + call["done"])
            return
        }
        emit("  ✖ the model sent an object with no tool in it")
        ai_told(history, "That did not name a tool. Use cmd, read, write, or say.")
    }
}

// ----------------------------------------------------------------- turn loop

// Drive turns from a transport until it returns null -- end of a pipe, or a
// phone that disconnected. Slash commands are handled here rather than inside
// handle_turn because several of them *change* state (`guard_on`, `key`,
// `url`, `model`), and a function assigning to a bare name creates a local of
// its own: that is how `:config model x` came to report success while
// changing nothing.
function turn_loop() {
    while true {
        line = next_line("you> ")
        if line == null { return true }
        line = line.trim()
        if line == "" { continue }
        if line == ":quit" or line == ":exit" or line == ":q" { return false }
        if line.startswith(":") {
            if !commands(line) { return false }
            continue
        }
        handle_turn(line)
    }
}

// -------------------------------------------------------------------- remote

// `OVYTH_AGENT_SERVE=<port>` makes the agent wait for connections instead of
// reading the keyboard, and every turn it serves is the same handle_turn the
// terminal runs — the tools, the guard and the model call do not know the
// difference.
//
// A listening agent is a remote shell on your PC. That is the point, and also
// the risk, so:
//   * `OVYTH_AGENT_TOKEN` makes the first line the client sends an
//     authentication step; a wrong or missing token closes the socket before
//     a single turn is served.
//   * `OVYTH_AGENT_HOST` defaults to 0.0.0.0 (a phone on the same network can
//     reach it); set it to 127.0.0.1 to keep the port private to this machine
//     and treat the agent as local.
if serve_port != "" {
    port = -1
    try { port = int(serve_port) } catch e { port = -1 }
    // Port 0 asks the kernel for a free one, which is what a test (or a second
    // agent on the same machine) wants: no hard-coded port to collide with. The
    // port actually bound is reported below, because it is not what was asked
    // for.
    if port < 0 or port > 65535 {
        emit("invalid OVYTH_AGENT_SERVE port: " + serve_port +
             " (use a port number, or 0 for any free port)")
    } else {
        listen_fd = net.listen(port, host = serve_host)
        if listen_fd >= 0 {
            bound = net.port(listen_fd)
            if port_file != "" {
                file.write(port_file, str(bound))
            }
            emit("listening on " + serve_host + ":" + str(bound) +
                 (agent_token == "" ? "  (no token: anyone who can reach this port can drive the agent)" : "  (token required)"))
            emit("waiting for a connection...  (ctrl-c to stop)")

            // One connection at a time, and the loop re-arms, so a phone that
            // drops off and returns picks up where it left off.
            while true {
                conn = {"fd": net.accept(listen_fd)}
                if conn["fd"] < 0 { break }

                if agent_token != "" {
                    net.write(conn["fd"], "token: ")
                    provided = socket_line(conn)
                    if provided == null or !equal_secret(provided.trim(), agent_token) {
                        emit("refused a bad token")
                        net.write(conn["fd"], "auth failed\n")
                        net.close(conn["fd"])
                        continue
                    }
                }

                net.write(conn["fd"], "ovyth agent -- model " + model + " :help for commands, :quit to disconnect\n")
                reader[0] = conn
                sink[0] = conn["fd"]
                emit("connected")
                stopped = turn_loop()
                net.write(conn["fd"], "bye\n")
                net.close(conn["fd"])
                reader[0] = "stdin"
                sink[0] = "print"
                emit("disconnected" + (stopped ? "" : " (:quit)"))
            }
        } else {
            emit("could not listen on " + serve_host + ":" + str(port))
        }
    }
    emit("")
    emit("bye")
} else {
    // Terminal mode: the agent as it has always been.
    turn_loop()
    emit("")
    emit("bye")
}
